<?xml version="1.0"?>
<!-- Register the legacy FlightGear dialog commands. Canvas draws the entire form. -->
<PropertyList>
	<name>vehicle-dialog</name>
	<width>1</width>
	<height>1</height>
	<visible><false/></visible>
	<nasal>
		<open>dialogs.vehicleDialog._openCanvas();</open>
		<close>dialogs.vehicleDialog._closeCanvas();</close>
	</nasal>
</PropertyList>
