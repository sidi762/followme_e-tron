<?xml version="1.0"?>

<!--
	Follow Me EV with the experimental tyre and driveline model.
	Uses the standard EV body with per-wheel spin and friction smoke from JSBSim.
	See dev/tyre-model/README.md.
-->
<PropertyList include="followme_e-tron-set.xml">
<sim>
	<description>Follow Me e-tron (tyre model prototype)</description>
	<variant-of>followme_e-tron</variant-of>
	<primary-set type="bool">false</primary-set>
	<long-description>
		The Follow Me EV on an experimental tyre and driveline model: the wheels have their own speed, so they can spin and lock, and grip is shared between cornering, braking and accelerating.
	</long-description>
	<aero>followme_e-tron-tyre</aero>
	<multiplay>
		<generic>
			<!-- Signed wheel angular speed (rad/s) and sliding smoke intensity (0..1). -->
			<bool n="13" type="bool">true</bool>
			<float n="29" alias="/fdm/jsbsim/tyre/fl/omega_rad_sec"/>
			<float n="30" alias="/fdm/jsbsim/tyre/fr/omega_rad_sec"/>
			<float n="31" alias="/fdm/jsbsim/tyre/bl/omega_rad_sec"/>
			<float n="32" alias="/fdm/jsbsim/tyre/br/omega_rad_sec"/>
			<float n="33" alias="/fdm/jsbsim/tyre/fl/smoke_norm"/>
			<float n="34" alias="/fdm/jsbsim/tyre/fr/smoke_norm"/>
			<float n="35" alias="/fdm/jsbsim/tyre/bl/smoke_norm"/>
			<float n="36" alias="/fdm/jsbsim/tyre/br/smoke_norm"/>
		</generic>
	</multiplay>
</sim>
<systems>
	<!-- Read by the FDM on every frame (Systems/tyre-model.xml). The co-driver
	     sits on the rear right seat and counts while "Enable co-driver model" is ticked. -->
	<occupants>
		<driver-kg type="double">60</driver-kg>
		<codriver-kg type="double">60</codriver-kg>
	</occupants>
</systems>
</PropertyList>
