<?xml version="1.0"?>
<PropertyList>
    <particlesystem include="tyre-spray-particles.xml">
        <condition>
            <or>
                <and>
                    <not><property>sim/multiplay/generic/bool[13]</property></not>
                    <property>sim/multiplay/generic/int[9]</property>
                </and>
                <and>
                    <greater-than><property>environment/rain-norm</property><value>0.2</value></greater-than>
                    <greater-than><property>velocities/groundspeed-kt</property><value>5</value></greater-than>
                    <property>gear/gear[2]/wow</property>
                </and>
            </or>
        </condition>
    </particlesystem>
</PropertyList>
