<?xml version="1.0"?>
<PropertyList>
    <name>tyre-friction-smoke</name>
    <texture>Effects/smoke.png</texture>
    <emissive>false</emissive>
    <lighting>false</lighting>
    <attach>world</attach>
    <align>billboard</align>
    <condition>
        <and>
            <property>sim/multiplay/generic/bool[13]</property>
            <less-than-equals><property>/environment/rain-norm</property><value>0.2</value></less-than-equals>
        </and>
    </condition>
    <placer><type>point</type></placer>
    <shooter>
        <theta-min-deg>5</theta-min-deg><theta-max-deg>55</theta-max-deg>
        <phi-min-deg>0</phi-min-deg><phi-max-deg>360</phi-max-deg>
        <speed-mps><value>1.1</value><spread>0.45</spread></speed-mps>
    </shooter>
    <particle>
        <start>
            <color>
                <red><value>0.72</value></red><green><value>0.72</value></green>
                <blue><value>0.72</value></blue><alpha><value>0.32</value></alpha>
            </color>
            <size><value>0.18</value></size>
        </start>
        <end>
            <color>
                <red><value>0.82</value></red><green><value>0.82</value></green>
                <blue><value>0.82</value></blue><alpha><value>0</value></alpha>
            </color>
            <size><value>1.3</value></size>
        </end>
        <life-sec><value>1.5</value></life-sec>
        <mass-kg>0.02</mass-kg><radius-m>0.10</radius-m>
    </particle>
    <program><fluid>air</fluid><gravity>false</gravity><wind>true</wind></program>
</PropertyList>
