	<stalk include="../Instruments/wiper-stalk.xml" omit-node="y"/>

<!-- Accelerator -->
<animation>
  <type>translate</type>
  <object-name>accelerator</object-name>
  <property>sim/multiplay/generic/float[22]</property>
  <factor> 0.05 </factor>
  <axis>
    <x>  -1 </x>
    <y>  0 </y>
    <z>  0 </z>
  </axis>
</animation>
<!-- Brake pedal -->
<animation include="../Instruments/brake-pedal.xml"/>
	<controls include="headlight-controls.xml" omit-node="y"/>
	<animation include="front-fog-pick.xml"/>
	<animation include="rear-fog-pick.xml"/>
	<animation>
		<type>rotate</type><object-name>headlight_switch</object-name><object-name>headlight_index</object-name>
		<property>sim/multiplay/generic/int[17]</property>
		<interpolation>
			<entry><ind>0</ind><dep>28.0</dep></entry>
			<entry><ind>1</ind><dep>0.0</dep></entry>
			<entry><ind>2</ind><dep>-30.4</dep></entry>
			<entry><ind>3</ind><dep>-63.8</dep></entry>
		</interpolation>
		<center><x-m>1.3104705</x-m><y-m>-0.5435577</y-m><z-m>1.0357984</z-m></center>
		<axis><x>0.9784557</x><y>0.1354214</y><z>0.1558384</z></axis>
	</animation>
	<controls include="esc-switch.xml" omit-node="y"/>
	<controls include="panel-brightness.xml" omit-node="y"/>
</PropertyList>
