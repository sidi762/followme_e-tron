<PropertyList>
	<animation>
		<type>pick</type>
		<object-name>headlight_off_label</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-assign</command>
				<property>/controls/lighting/headlight-selector</property>
				<value>0</value>
			</binding>
		</action>
	</animation>
	<animation>
		<type>pick</type>
		<object-name>headlight_auto_label</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-assign</command>
				<property>/controls/lighting/headlight-selector</property>
				<value>1</value>
			</binding>
		</action>
	</animation>
	<animation>
		<type>pick</type>
		<object-name>headlight_position_label</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-assign</command>
				<property>/controls/lighting/headlight-selector</property>
				<value>2</value>
			</binding>
		</action>
	</animation>
	<animation>
		<type>pick</type>
		<object-name>headlight_dipped_label</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-assign</command>
				<property>/controls/lighting/headlight-selector</property>
				<value>3</value>
			</binding>
		</action>
	</animation>
	<animation>
		<type>pick</type>
		<object-name>headlight_switch</object-name>
		<object-name>headlight_mode_key</object-name>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>followme.stepHeadlightSelector(1, 1)</script>
			</binding>
			<binding>
				<command>property-assign</command>
				<property>/controls/lighting/selector-pressed</property>
				<value>1</value>
			</binding>
			<mod-up>
				<binding>
					<command>property-assign</command>
					<property>/controls/lighting/selector-pressed</property>
					<value>0</value>
				</binding>
			</mod-up>
		</action>
		<action>
			<button>3</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>followme.stepHeadlightSelector(1)</script>
			</binding>
		</action>
		<action>
			<button>4</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>followme.stepHeadlightSelector(-1)</script>
			</binding>
		</action>
	</animation>
</PropertyList>
