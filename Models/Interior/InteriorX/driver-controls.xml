<PropertyList>
	<animation>
		<type>pick</type>
		<object-name>armrest_lid</object-name>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-toggle</command>
				<property>/controls/interior/armrest_cover_pos</property>
			</binding>
		</action>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>cruise_set_plus</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>autospeed.wheelSet()</script>
			</binding>
		</action>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>cruise_resume_minus</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>autospeed.wheelResume()</script>
			</binding>
		</action>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>cruise_cancel</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>autospeed.cancelSpeedHold()</script>
			</binding>
		</action>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>cruise</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>autospeed.toggleSpeedHold()</script>
			</binding>
		</action>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>autocrash</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>autopilot.toggle_auto_pilot()</script>
			</binding>
		</action>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>headlight_off_label</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-assign</command>
				<property>/controls/lighting/headlight-selector</property>
				<value>0</value>
			</binding>
		</action>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>headlight_auto_label</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-assign</command>
				<property>/controls/lighting/headlight-selector</property>
				<value>1</value>
			</binding>
		</action>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>headlight_position_label</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-assign</command>
				<property>/controls/lighting/headlight-selector</property>
				<value>2</value>
			</binding>
		</action>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>headlight_dipped_label</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-assign</command>
				<property>/controls/lighting/headlight-selector</property>
				<value>3</value>
			</binding>
		</action>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>headlight_switch</object-name>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>followme.stepHeadlightSelector(1, 1)</script>
			</binding>
		</action>
		<action>
			<button>3</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>followme.stepHeadlightSelector(1)</script>
			</binding>
		</action>
		<action>
			<button>4</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>followme.stepHeadlightSelector(-1)</script>
			</binding>
		</action>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>front_foglight_switch</object-name>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-toggle</command>
				<property>/controls/lighting/front-fog</property>
			</binding>
		</action>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>rear_foglight_switch</object-name>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-toggle</command>
				<property>/controls/lighting/rear-fog</property>
			</binding>
		</action>
	</animation>
</PropertyList>
