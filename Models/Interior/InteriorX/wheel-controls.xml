<PropertyList>
	<animation>
		<type>pick</type>
		<object-name>cruise_set_plus</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>autospeed.wheelSet()</script>
			</binding>
		</action>
	</animation>
	<animation>
		<type>pick</type>
		<object-name>cruise_resume_minus</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>autospeed.wheelResume()</script>
			</binding>
		</action>
	</animation>
	<animation>
		<type>pick</type>
		<object-name>cruise_cancel</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>autospeed.cancelSpeedHold()</script>
			</binding>
		</action>
	</animation>
	<animation>
		<type>pick</type>
		<object-name>cruise</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>autospeed.toggleSpeedHold()</script>
			</binding>
		</action>
	</animation>
	<animation>
		<type>pick</type>
		<object-name>autocrash</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>autopilot.toggle_auto_pilot()</script>
			</binding>
		</action>
	</animation>
	<animation>
		<type>pick</type>
		<object-name>page_up</object-name>
		<object-name>page_left</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<binding>
				<command>nasal</command>
				<script>smartInstruments.smartInstruments.previousCenterScreen()</script>
			</binding>
		</action>
	</animation>
	<animation>
		<type>pick</type>
		<object-name>page_down</object-name>
		<object-name>page_right</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<binding>
				<command>nasal</command>
				<script>smartInstruments.smartInstruments.nextCenterScreen()</script>
			</binding>
		</action>
	</animation>
	<animation>
		<type>pick</type>
		<object-name>page_ok</object-name>
		<visible>false</visible>
		<action>
			<button>0</button>
			<binding>
				<command>nasal</command>
				<script>smartInstruments.smartInstruments.pageKey(1)</script>
			</binding>
			<mod-up>
				<binding>
					<command>nasal</command>
					<script>smartInstruments.smartInstruments.pageKey(0)</script>
				</binding>
			</mod-up>
		</action>
	</animation>
</PropertyList>
