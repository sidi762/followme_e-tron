<PropertyList>

<path>404Design2023.ac</path>

<effect>
    <inherits-from>Aircraft/followme_e-tron/Models/Effects/interior</inherits-from>
    <object-name>Mesh63</object-name>
    <object-name>Mesh64</object-name>
    <object-name>Mesh68</object-name>
    <object-name>Mesh69</object-name>
</effect>


<!-- Decoration -->
<animation>
 <type>select</type>
 <object-name>baowenbei</object-name>
 <condition>

     <equals>
         <property>sim/multiplay/generic/bool[0]</property>
         <value>1</value>
     </equals>

 </condition>
</animation>

<!-- Armrest Box -->
<animation>
    <type>pick</type>
    <object-name>armrest_box_cover</object-name>
    <action>
      <button>0</button>
      <binding>
          <command>property-cycle</command>
          <property>controls/interior/armrest_cover_pos</property>
          <value type="double">0</value>
          <value type="double">1</value>
      </binding>
    </action>
</animation>
<animation>
    <type>rotate</type>
    <object-name>armrest_box_cover</object-name>
    <property>sim/multiplay/generic/float[27]</property>
    <interpolation>
        <entry>
            <ind> 0.0 </ind>
            <dep> 0.0 </dep>
        </entry>
        <entry>
            <ind> 0.1 </ind>
            <dep> 0.0 </dep>
        </entry>
        <entry>
            <ind> 0.2</ind>
            <dep> 3 </dep>
        </entry>
        <entry>
            <ind> 0.3</ind>
            <dep> 18 </dep>
        </entry>
        <entry>
            <ind> 1.0 </ind>
            <dep> 60.0 </dep>
        </entry>
    </interpolation>
    <offset-m>0</offset-m>
    <center>
        <x-m>1.949</x-m>
        <y-m>0</y-m>
        <z-m>0.766</z-m>
    </center>
    <axis>
        <x>0</x>
        <y>1</y>
        <z>0</z>
    </axis>
</animation>

<!-- AEB -->
<animation>
     <type>select</type>
     <object-name>AEB_LIT</object-name>
     <condition>
         <equals>
	 	     <property>sim/multiplay/generic/bool[4]</property>
	 	     <value>1</value>
	     </equals>
     </condition>
</animation>

	<controls include="404Design-driving-controls.xml" omit-node="y"/>
</PropertyList>
