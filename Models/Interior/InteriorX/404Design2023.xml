<PropertyList>

<path>404Design2023.ac</path>

<effect>
    <inherits-from>Aircraft/followme_e-tron/Models/Effects/interior</inherits-from>
    <object-name>Mesh63</object-name>
    <object-name>Mesh64</object-name>
    <object-name>Mesh68</object-name>
    <object-name>Mesh69</object-name>
</effect>


<!-- Decoration -->
<animation>
 <type>select</type>
 <object-name>baowenbei</object-name>
 <condition>

     <equals>
         <property>sim/multiplay/generic/bool[0]</property>
         <value>1</value>
     </equals>

 </condition>
</animation>

<!-- Armrest Box -->
<animation>
    <type>pick</type>
    <object-name>armrest_box_cover</object-name>
    <action>
      <button>0</button>
      <binding>
          <command>property-cycle</command>
          <property>controls/interior/armrest_cover_pos</property>
          <value type="double">0</value>
          <value type="double">1</value>
      </binding>
    </action>
</animation>
<animation>
    <type>rotate</type>
    <object-name>armrest_box_cover</object-name>
    <property>sim/multiplay/generic/float[27]</property>
    <factor>60</factor>
    <offset-m>0</offset-m>
    <center>
        <x-m>1.949</x-m>
        <y-m>0</y-m>
        <z-m>0.766</z-m>
    </center>
    <axis>
        <x>0</x>
        <y>1</y>
        <z>0</z>
    </axis>
</animation>


	<controls include="404Design-driving-controls.xml" omit-node="y"/>
	<controls include="headlight-controls.xml" omit-node="y"/>
	<animation include="front-fog-pick.xml"/>
	<animation include="rear-fog-pick.xml"/>
	<animation>
		<type>rotate</type><object-name>headlight_switch</object-name><object-name>headlight_index</object-name>
		<property>sim/multiplay/generic/int[17]</property>
		<interpolation>
			<entry><ind>0</ind><dep>33.4</dep></entry>
			<entry><ind>1</ind><dep>0.0</dep></entry>
			<entry><ind>2</ind><dep>-38.0</dep></entry>
			<entry><ind>3</ind><dep>-76.7</dep></entry>
		</interpolation>
		<center><x-m>1.3616904</x-m><y-m>-0.5534030</y-m><z-m>0.9221941</z-m></center>
		<axis><x>0.7755673</x><y>-0.0000046</y><z>0.6312648</z></axis>
	</animation>
	<controls include="esc-switch.xml" omit-node="y"/>
	<controls include="panel-brightness.xml" omit-node="y"/>
</PropertyList>
