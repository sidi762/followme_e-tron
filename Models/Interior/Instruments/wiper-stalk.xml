<PropertyList>
	<animation>
		<type>pick</type>
		<object-name>right_handle</object-name>
		<object-name>wipercontrol</object-name>
		<action>
			<button>0</button>
			<binding>
				<command>nasal</command>
				<script>followme.frontWiper.cycleMode()</script>
			</binding>
		</action>
		<action>
			<button>1</button>
			<binding>
				<command>nasal</command>
				<script>followme.rearWiper.cycleMode()</script>
			</binding>
		</action>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>right_handle</object-name>
		<object-name>wipercontrol</object-name>
		<property>controls/wiper/frontwiper/mode</property>
		<interpolation>
			<entry>
				<ind>0</ind>
				<dep>0</dep>
			</entry>
			<entry>
				<ind>1</ind>
				<dep>15</dep>
			</entry>
			<entry>
				<ind>2</ind>
				<dep>10</dep>
			</entry>
			<entry>
				<ind>3</ind>
				<dep>5</dep>
			</entry>
		</interpolation>
		<center>
			<x-m>1.4165</x-m>
			<y-m>-0.2701</y-m>
			<z-m>0.9279</z-m>
		</center>
		<axis>
			<x>1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>
</PropertyList>
